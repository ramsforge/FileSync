<Window x:Class="FileSync.App.Views.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
        xmlns:vm="clr-namespace:FileSync.App.ViewModels"
        mc:Ignorable="d"
        Title="FileSync - Native Android &amp; Windows Sharing"
        Height="720" Width="1050"
        MinHeight="600" MinWidth="850"
        WindowStartupLocation="CenterScreen"
        Background="#181818"
        Foreground="#F3F3F3">

    <Window.DataContext>
        <vm:MainViewModel x:Name="ViewModel" />
    </Window.DataContext>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- Device Connection Header -->
        <Border Grid.Row="0" Background="#222222" CornerRadius="8" Margin="20,15,20,10" Padding="15,10">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,15,0">
                    <TextBlock Text="📱" FontSize="20" Margin="0,0,8,0" VerticalAlignment="Center" />
                    <TextBlock Text="Target Device:" FontWeight="SemiBold" VerticalAlignment="Center" FontSize="14" Foreground="#F3F3F3" />
                </StackPanel>

                <!-- Device Selector ComboBox -->
                <ComboBox Grid.Column="1" ItemsSource="{Binding AvailableDevices}" 
                          SelectedItem="{Binding SelectedDevice, Mode=TwoWay}"
                          VerticalAlignment="Center" HorizontalAlignment="Stretch" Margin="0,0,15,0">
                    <ComboBox.ItemTemplate>
                        <DataTemplate>
                            <StackPanel Orientation="Horizontal" Margin="4,2">
                                <TextBlock Text="{Binding Name}" FontWeight="Medium" Margin="0,0,10,0" />
                                <Border Background="#250078D4" CornerRadius="4" Padding="6,2" Margin="0,0,10,0">
                                    <TextBlock Text="{Binding ConnectionType}" FontSize="11" Foreground="#4CC2FF" />
                                </Border>
                                <TextBlock Text="{Binding EndPoint}" Opacity="0.6" FontSize="12" VerticalAlignment="Center" />
                            </StackPanel>
                        </DataTemplate>
                    </ComboBox.ItemTemplate>
                </ComboBox>

                <ui:Button Grid.Column="2" Content="🔄 Scan" 
                           Command="{Binding ScanDevicesCommand}" Margin="0,0,10,0" />

                <ui:Button Grid.Column="3" Content="🔌 Connect USB (ADB)" 
                           Command="{Binding ConnectUsbAdbCommand}" Appearance="Secondary" />
            </Grid>
        </Border>

        <!-- Main Body: Destination Bar, Drop Zone & Transfer Queue -->
        <Grid Grid.Row="1" Margin="20,0,20,10">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="110" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <!-- Destination Folder Configuration Bar -->
            <Border Grid.Row="0" Background="#1E1E1E" CornerRadius="8" Margin="0,0,0,8" Padding="12,6">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <TextBlock Grid.Column="0" Text="📂" FontSize="15" VerticalAlignment="Center" Margin="0,0,8,0" />
                    <TextBlock Grid.Column="1" Text="Save Received Files To:" FontWeight="SemiBold" FontSize="12" VerticalAlignment="Center" Margin="0,0,10,0" Foreground="#CCCCCC" />
                    <TextBox Grid.Column="2" Text="{Binding OutputDirectory, Mode=OneWay}" IsReadOnly="True" 
                             Background="#141414" Foreground="#4CC2FF" BorderBrush="#33FFFFFF" Padding="8,4" 
                             VerticalAlignment="Center" ToolTip="{Binding OutputDirectory}" />
                    <ui:Button Grid.Column="3" Content="Change Folder..." Command="{Binding ChangeOutputFolderCommand}" 
                               Margin="8,0,6,0" Appearance="Secondary" />
                    <ui:Button Grid.Column="4" Content="Open Folder" Command="{Binding OpenReceivedFolderCommand}" 
                               Click="OpenReceivedFolder_Click" Appearance="Secondary" />
                </Grid>
            </Border>

            <!-- Interactive Drag and Drop Zone -->
            <Border Grid.Row="1" Margin="0,0,0,10" CornerRadius="8"
                    BorderThickness="2" BorderBrush="#40FFFFFF" Background="#1E1E1E"
                    AllowDrop="True" Drop="DropZone_Drop" DragOver="DropZone_DragOver" DragLeave="DropZone_DragLeave">
                <Grid HorizontalAlignment="Center" VerticalAlignment="Center">
                    <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                        <TextBlock Text="⬆" FontSize="30" FontWeight="Bold" Foreground="#4CC2FF" HorizontalAlignment="Center" Margin="0,0,0,4" />
                        <TextBlock Text="Drag and drop files or entire folders here" 
                                   FontWeight="SemiBold" FontSize="14" Foreground="#F3F3F3" HorizontalAlignment="Center" />
                        <TextBlock Text="Preserves nanosecond timestamps, folder trees, and original bit-for-bit size" 
                                   Opacity="0.6" FontSize="11" Foreground="#AAAAAA" HorizontalAlignment="Center" Margin="0,2,0,0" />
                    </StackPanel>
                </Grid>
            </Border>

            <!-- File Queue ListView -->
            <ui:DataGrid Grid.Row="2" ItemsSource="{Binding Queue}" AutoGenerateColumns="False" 
                         CanUserAddRows="False" CanUserDeleteRows="False" SelectionMode="Single"
                         HeadersVisibility="Column" HorizontalScrollBarVisibility="Auto">
                <ui:DataGrid.Columns>
                    <DataGridTextColumn Header="Name" Binding="{Binding Name}" Width="2*" />
                    <DataGridTextColumn Header="Relative Path" Binding="{Binding RelativePath}" Width="3*" />
                    <DataGridTextColumn Header="Size" Binding="{Binding FormattedSize}" Width="100" />
                    <DataGridTextColumn Header="Status" Binding="{Binding Status}" Width="110" />
                    <DataGridTemplateColumn Header="Progress" Width="160">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <Grid VerticalAlignment="Center" Margin="4,0">
                                    <ProgressBar Value="{Binding Progress, Mode=OneWay}" Height="8" Minimum="0" Maximum="100" />
                                </Grid>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>
                </ui:DataGrid.Columns>
            </ui:DataGrid>
        </Grid>

        <!-- Transfer Performance Panel -->
        <Border Grid.Row="2" Background="#222222" CornerRadius="8" Margin="20,0,20,10" Padding="15,12">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <!-- Speed, Transferred, ETA Stats -->
                <Grid Grid.Row="0" Margin="0,0,0,8">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <TextBlock Grid.Column="0" Text="{Binding StatusMessage}" FontSize="13" VerticalAlignment="Center" FontWeight="Medium" Foreground="#F3F3F3" />

                    <StackPanel Grid.Column="1" Orientation="Horizontal" Margin="0,0,25,0">
                        <TextBlock Text="Speed: " Opacity="0.6" FontSize="13" Foreground="#AAAAAA" />
                        <TextBlock Text="{Binding CurrentSpeedText}" FontWeight="Bold" Foreground="#4CC2FF" FontSize="13" />
                    </StackPanel>

                    <StackPanel Grid.Column="2" Orientation="Horizontal" Margin="0,0,25,0">
                        <TextBlock Text="Transferred: " Opacity="0.6" FontSize="13" Foreground="#AAAAAA" />
                        <TextBlock Text="{Binding TransferredBytesText}" FontWeight="SemiBold" FontSize="13" Foreground="#F3F3F3" />
                    </StackPanel>

                    <StackPanel Grid.Column="3" Orientation="Horizontal">
                        <TextBlock Text="ETA: " Opacity="0.6" FontSize="13" Foreground="#AAAAAA" />
                        <TextBlock Text="{Binding EtaText}" FontWeight="SemiBold" FontSize="13" Foreground="#F3F3F3" />
                    </StackPanel>
                </Grid>

                <!-- Overall Progress Bar -->
                <ProgressBar Grid.Row="1" Value="{Binding TotalProgress}" Minimum="0" Maximum="100" Height="10" />
            </Grid>
        </Border>

        <!-- Bottom Action Bar & Status -->
        <Border Grid.Row="3" Background="#141414" Padding="20,12">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <!-- Rust Core Version Badge -->
                <Border Grid.Column="0" Background="#2000FF00" CornerRadius="4" Padding="8,4" Margin="0,0,15,0">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="Rust Core: " FontSize="11" Opacity="0.7" Foreground="#CCCCCC" />
                        <TextBlock Text="{Binding CoreVersion}" FontSize="11" FontWeight="SemiBold" Foreground="#6CCB5F" />
                    </StackPanel>
                </Border>

                <!-- Explorer Context Menu Toggle -->
                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                    <ui:ToggleSwitch IsChecked="{Binding IsContextMenuEnabled, Mode=OneWay}" 
                                     Command="{Binding ToggleContextMenuCommand}" Margin="0,0,6,0" />
                    <TextBlock Text="Explorer Right-Click Menu" FontSize="12" VerticalAlignment="Center" Opacity="0.8" Foreground="#CCCCCC" />
                </StackPanel>

                <!-- Buttons -->
                <ui:Button Grid.Column="3" Content="📁 Received Files" 
                           Command="{Binding OpenReceivedFolderCommand}" Click="OpenReceivedFolder_Click" Appearance="Secondary" Margin="0,0,10,0" />

                <ui:Button Grid.Column="4" Content="➕ Add Files" 
                           Command="{Binding AddFilesCommand}" Margin="0,0,10,0" />

                <ui:Button Grid.Column="5" Content="🧹 Clear Sent" 
                           Command="{Binding ClearCompletedCommand}" Appearance="Secondary" Margin="0,0,10,0" />

                <ui:Button Grid.Column="6" Content="🗑️ Clear All" 
                           Command="{Binding ClearQueueCommand}" Appearance="Secondary" Margin="0,0,10,0" />

                <ui:Button Grid.Column="7" Content="🚀 Send to Android" 
                           Command="{Binding StartTransferCommand}" Appearance="Primary" FontWeight="Bold" Padding="20,6" />
            </Grid>
        </Border>
    </Grid>
</Window>
