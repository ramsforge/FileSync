<ui:FluentWindow x:Class="FileSync.App.Views.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
        xmlns:vm="clr-namespace:FileSync.App.ViewModels"
        mc:Ignorable="d"
        Title="FileSync - Native Android &amp; Windows Sharing"
        Height="720" Width="1050"
        MinHeight="600" MinWidth="850"
        WindowStartupLocation="CenterScreen"
        WindowBackdropType="Mica"
        ExtendsContentIntoTitleBar="True">

    <Window.DataContext>
        <vm:MainViewModel x:Name="ViewModel" />
    </Window.DataContext>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- Window TitleBar -->
        <ui:TitleBar Grid.Row="0" Title="FileSync - High Speed File Sharing" ShowMaximize="True" ShowMinimize="True">
            <ui:TitleBar.Icon>
                <ui:ImageIcon Source="pack://application:,,,/Assets/app.ico" />
            </ui:TitleBar.Icon>
        </ui:TitleBar>

        <!-- Device Connection Header -->
        <Border Grid.Row="1" Background="#18FFFFFF" CornerRadius="8" Margin="20,10,20,10" Padding="15,10">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,15,0">
                    <ui:SymbolIcon Symbol="DeviceMobile24" FontSize="22" Margin="0,0,8,0" Foreground="#0078D4" />
                    <TextBlock Text="Target Device:" FontWeight="SemiBold" VerticalAlignment="Center" FontSize="14" />
                </StackPanel>

                <!-- Device Selector ComboBox -->
                <ComboBox Grid.Column="1" ItemsSource="{Binding AvailableDevices}" 
                          SelectedItem="{Binding SelectedDevice, Mode=TwoWay}"
                          VerticalAlignment="Center" HorizontalAlignment="Stretch" Margin="0,0,15,0">
                    <ComboBox.ItemTemplate>
                        <DataTemplate>
                            <StackPanel Orientation="Horizontal" Margin="4,2">
                                <TextBlock Text="{Binding Name}" FontWeight="Medium" Margin="0,0,10,0" />
                                <Border Background="#250078D4" CornerRadius="4" Padding="6,2" Margin="0,0,10,0">
                                    <TextBlock Text="{Binding ConnectionType}" FontSize="11" Foreground="#4CC2FF" />
                                </Border>
                                <TextBlock Text="{Binding EndPoint}" Opacity="0.6" FontSize="12" VerticalAlignment="Center" />
                            </StackPanel>
                        </DataTemplate>
                    </ComboBox.ItemTemplate>
                </ComboBox>

                <ui:Button Grid.Column="2" Icon="{ui:SymbolIcon ArrowClockwise24}" Content="Scan" 
                           Command="{Binding ScanDevicesCommand}" Margin="0,0,10,0" />

                <ui:Button Grid.Column="3" Icon="{ui:SymbolIcon Usb24}" Content="Connect USB (ADB)" 
                           Command="{Binding ConnectUsbAdbCommand}" Appearance="Secondary" />
            </Grid>
        </Border>

        <!-- Main Body: Drop Zone & Transfer Queue -->
        <Grid Grid.Row="2" Margin="20,5,20,10">
            <Grid.RowDefinitions>
                <RowDefinition Height="130" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <!-- Interactive Drag and Drop Zone -->
            <Border Grid.Row="0" Margin="0,0,0,10" CornerRadius="8"
                    BorderThickness="2" BorderBrush="#40FFFFFF" Background="#0CFFFFFF"
                    AllowDrop="True" Drop="DropZone_Drop" DragOver="DropZone_DragOver" DragLeave="DropZone_DragLeave">
                <Grid HorizontalAlignment="Center" VerticalAlignment="Center">
                    <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                        <ui:SymbolIcon Symbol="ArrowUpload24" FontSize="36" Foreground="#4CC2FF" HorizontalAlignment="Center" Margin="0,0,0,8" />
                        <TextBlock Text="Drag and drop files or entire folders here" 
                                   FontWeight="SemiBold" FontSize="15" HorizontalAlignment="Center" />
                        <TextBlock Text="Preserves nanosecond timestamps, folder trees, and original bit-for-bit size" 
                                   Opacity="0.6" FontSize="12" HorizontalAlignment="Center" Margin="0,4,0,0" />
                    </StackPanel>
                </Grid>
            </Border>

            <!-- File Queue ListView -->
            <ui:DataGrid Grid.Row="1" ItemsSource="{Binding Queue}" AutoGenerateColumns="False" 
                         CanUserAddRows="False" CanUserDeleteRows="False" SelectionMode="Single"
                         HeadersVisibility="Column" HorizontalScrollBarVisibility="Auto">
                <ui:DataGrid.Columns>
                    <DataGridTextColumn Header="Name" Binding="{Binding Name}" Width="2*" />
                    <DataGridTextColumn Header="Relative Path" Binding="{Binding RelativePath}" Width="3*" />
                    <DataGridTextColumn Header="Size" Binding="{Binding FormattedSize}" Width="100" />
                    <DataGridTextColumn Header="Status" Binding="{Binding Status}" Width="110" />
                    <DataGridTemplateColumn Header="Progress" Width="160">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <Grid VerticalAlignment="Center" Margin="4,0">
                                    <ProgressBar Value="{Binding Progress, Mode=OneWay}" Height="8" Minimum="0" Maximum="100" />
                                </Grid>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>
                </ui:DataGrid.Columns>
            </ui:DataGrid>
        </Grid>

        <!-- Transfer Performance Panel -->
        <Border Grid.Row="3" Background="#12FFFFFF" CornerRadius="8" Margin="20,0,20,10" Padding="15,12">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <!-- Speed, Transferred, ETA Stats -->
                <Grid Grid.Row="0" Margin="0,0,0,8">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <TextBlock Grid.Column="0" Text="{Binding StatusMessage}" FontSize="13" VerticalAlignment="Center" FontWeight="Medium" />

                    <StackPanel Grid.Column="1" Orientation="Horizontal" Margin="0,0,25,0">
                        <TextBlock Text="Speed: " Opacity="0.6" FontSize="13" />
                        <TextBlock Text="{Binding CurrentSpeedText}" FontWeight="Bold" Foreground="#4CC2FF" FontSize="13" />
                    </StackPanel>

                    <StackPanel Grid.Column="2" Orientation="Horizontal" Margin="0,0,25,0">
                        <TextBlock Text="Transferred: " Opacity="0.6" FontSize="13" />
                        <TextBlock Text="{Binding TransferredBytesText}" FontWeight="SemiBold" FontSize="13" />
                    </StackPanel>

                    <StackPanel Grid.Column="3" Orientation="Horizontal">
                        <TextBlock Text="ETA: " Opacity="0.6" FontSize="13" />
                        <TextBlock Text="{Binding EtaText}" FontWeight="SemiBold" FontSize="13" />
                    </StackPanel>
                </Grid>

                <!-- Overall Progress Bar -->
                <ProgressBar Grid.Row="1" Value="{Binding TotalProgress}" Minimum="0" Maximum="100" Height="10" />
            </Grid>
        </Border>

        <!-- Bottom Action Bar & Status -->
        <Border Grid.Row="4" Background="#1A000000" Padding="20,10">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <!-- Rust Core Version Badge -->
                <Border Grid.Column="0" Background="#2000FF00" CornerRadius="4" Padding="6,3" Margin="0,0,15,0">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="Rust Core: " FontSize="11" Opacity="0.7" />
                        <TextBlock Text="{Binding CoreVersion}" FontSize="11" FontWeight="SemiBold" Foreground="#6CCB5F" />
                    </StackPanel>
                </Border>

                <!-- Explorer Context Menu Toggle -->
                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                    <ui:ToggleSwitch IsChecked="{Binding IsContextMenuEnabled, Mode=OneWay}" 
                                     Command="{Binding ToggleContextMenuCommand}" Margin="0,0,6,0" />
                    <TextBlock Text="Explorer Right-Click Menu" FontSize="12" VerticalAlignment="Center" Opacity="0.8" />
                </StackPanel>

                <!-- Buttons -->
                <ui:Button Grid.Column="3" Icon="{ui:SymbolIcon Add24}" Content="Add Files" 
                           Command="{Binding AddFilesCommand}" Margin="0,0,10,0" />

                <ui:Button Grid.Column="4" Icon="{ui:SymbolIcon Delete24}" Content="Clear Queue" 
                           Command="{Binding ClearQueueCommand}" Appearance="Secondary" Margin="0,0,10,0" />

                <ui:Button Grid.Column="5" Icon="{ui:SymbolIcon Send24}" Content="Send to Android" 
                           Command="{Binding StartTransferCommand}" Appearance="Primary" FontWeight="Bold" Padding="20,6" />
            </Grid>
        </Border>
    </Grid>
</ui:FluentWindow>
